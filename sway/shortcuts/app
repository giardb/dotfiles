
## Application // Shortcut viewer // <mod><shift><h>

# Volume and brightness show a popup (swayosd); volume is capped at 100%.
bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise --max-volume 100
bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym $mod+Alt+m exec swayosd-client --input-volume mute-toggle

bindsym --locked XF86MonBrightnessDown exec swayosd-client --brightness lower
bindsym --locked XF86MonBrightnessUp exec swayosd-client --brightness raise

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

## Capture // Screenshots and recording // <Print> ##
# Saved to ~/Pictures/Screenshots and copied to the clipboard.
bindsym Print exec ~/.config/sway/scripts/screenshot screen
bindsym Shift+Print exec ~/.config/sway/scripts/screenshot region
bindsym $mod+Print exec ~/.config/sway/scripts/screenshot window
bindsym $mod+Shift+Print exec ~/.config/sway/scripts/screenshot edit
# Start / stop recording a selected area, saved to ~/Videos.
bindsym $mod+Ctrl+Print exec ~/.config/sway/scripts/record

## Clipboard // History // <mod><c> ##
bindsym $mod+c exec ~/.config/sway/scripts/clipboard

## Display // Night light // <mod><n> ##
bindsym $mod+n exec ~/.config/sway/scripts/nightlight toggle

## Appearance // Theme switcher // <mod><t> ##
bindsym $mod+t exec ~/.config/theme-switcher/theme-switch menu
