### Output configuration
#
# Wallpaper is set per theme by ~/.config/theme-switcher (see ~/.config/sway/theme)
# Layout: Dell ultrawide above the laptop panel, ASUS to its left.

set $laptop eDP-1

bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

output eDP-1 {
	mode 1920x1200
	scale 1
	pos 0 0
}

output 'Dell Inc. DELL S3422DWG 4ZB3T63' {   
 	mode 3440x1440@99.982Hz
 	scale 1.33    
 	pos 0 -1080
 	adaptive_sync on
}

output 'ASUSTek COMPUTER INC VG278 K7LMQS065714' {
	enable
	power on
	mode 1920x1080
	pos -1920 0
}
