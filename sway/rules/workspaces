#
# Rules for workspaces based on output
#
# Monitors are matched by name (make model serial) rather than connector
# (DP-6, DP-7...), because connector names change between docks and reboots.
# Each line lists outputs in order of preference.
#   Dell: 'Dell Inc. DELL S3422DWG 4ZB3T63'  (ultrawide)
#   ASUS: 'ASUSTek COMPUTER INC VG278 K7LMQS065714'

workspace $ws1 output 'Dell Inc. DELL S3422DWG 4ZB3T63' $laptop
workspace $ws2 output 'ASUSTek COMPUTER INC VG278 K7LMQS065714' $laptop
workspace $ws3 output $laptop 'Dell Inc. DELL S3422DWG 4ZB3T63'
workspace $ws4 output $laptop 'Dell Inc. DELL S3422DWG 4ZB3T63'
workspace $ws5 output $laptop 'Dell Inc. DELL S3422DWG 4ZB3T63'
workspace $ws6 output $laptop 'Dell Inc. DELL S3422DWG 4ZB3T63'
